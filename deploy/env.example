# Production settings for the plaintrace stack.
#
# Copy this file to /home/switchlabs/plaintrace/.env on the server and edit it:
#   cp deploy/env.example /home/switchlabs/plaintrace/.env && chmod 600 /home/switchlabs/plaintrace/.env
# It holds secrets and is NEVER committed. The Jenkins pipeline reads it and updates CUSTOM_TAG itself.

# --- compose -------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=plaintrace
CUSTOM_IMAGE=plaintrace
# Set by the pipeline on every deploy (do not edit by hand, except to roll back manually).
CUSTOM_TAG=none
# The image is built on this server and never pushed, so never try to pull it.
PULL_POLICY=never
RESTART_POLICY=unless-stopped

# --- database ------------------------------------------------------------------------------
# MariaDB root password. Choose a long random one; it is also used by the pipeline for restores.
DB_PASSWORD=change-me-to-a-long-random-password

# --- site ----------------------------------------------------------------------------------
# Name of the Frappe site the pipeline creates on the first run.
SITE_NAME=plaintrace.local
# Serve this one site for ANY host name or IP, so http://<lan-ip>:8081 just works.
FRAPPE_SITE_NAME_HEADER=plaintrace.local
# TEMPORARY. The Administrator password given to the site on its first creation only (the CREATE_SITE run).
# After your first login: put the password in a password manager and DELETE THIS LINE from the server's .env.
# Nothing else reads it. (To create a site again, add the line back for that one run, then delete it again.)
ADMIN_PASSWORD=change-me-too

# --- network (LAN only) --------------------------------------------------------------------
# Publish on the server's LAN address only, so nothing else can reach it. 8080 is used by Jenkins.
HTTP_PUBLISH_PORT=192.168.0.172:8081
# How the pipeline (running inside the Jenkins container) reaches the site for its smoke test.
SMOKE_URL=http://192.168.0.172:8081
# Used by Frappe when it builds links.
PUBLIC_URL=http://192.168.0.172:8081

# --- tuning (defaults are fine for this server) --------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
