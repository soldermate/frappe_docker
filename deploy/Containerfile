# Production image for plaintrace_engineering (frappe + the app only, no ERPNext).
#
# A copy of images/layered/Containerfile with ONE change: the Frappe version is split in two, so
# production can be pinned to the exact Frappe release used in development.
#   FRAPPE_IMAGE_TAG  tag of the prebuilt frappe/build and frappe/base images (a rolling branch tag)
#   FRAPPE_REF        the Frappe git tag/branch that `bench init` installs (pin it, e.g. v16.22.0)
# The upstream file uses one FRAPPE_BRANCH for both, which cannot pin a git tag because no matching
# base-image tag exists.
#
# Build (see deploy/Jenkinsfile), from the repository root:
#   docker build -f deploy/Containerfile \
#     --build-arg FRAPPE_REF=v16.22.0 --build-arg CACHE_BUST=<app sha> \
#     --secret id=apps_json,src=apps.json -t plaintrace:<tag> .
# apps.json is a BuildKit secret (never written into a layer):
#   [{"url": "https://x-access-token:<token>@github.com/soldermate/plaintrace_engineering", "branch": "<ref>"}]

ARG FRAPPE_IMAGE_TAG=version-16
ARG FRAPPE_IMAGE_PREFIX=frappe

FROM ${FRAPPE_IMAGE_PREFIX}/build:${FRAPPE_IMAGE_TAG} AS builder

ARG FRAPPE_REF=v16.22.0
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG CACHE_BUST=""

USER frappe

RUN --mount=type=secret,id=apps_json,target=/opt/frappe/apps.json,uid=1000,gid=1000 \
  : "${CACHE_BUST}" && \
  export APP_INSTALL_ARGS="" && \
  if [ -f /opt/frappe/apps.json ] && [ -s /opt/frappe/apps.json ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi && \
  bench init ${APP_INSTALL_ARGS}\
    --frappe-branch=${FRAPPE_REF} \
    --frappe-path=${FRAPPE_PATH} \
    --no-procfile \
    --no-backups \
    --skip-redis-config-generation \
    --verbose \
    /home/frappe/frappe-bench && \
  cd /home/frappe/frappe-bench && \
  echo "{}" > sites/common_site_config.json && \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

FROM ${FRAPPE_IMAGE_PREFIX}/base:${FRAPPE_IMAGE_TAG} AS backend

ARG APP_REF=""
ARG APP_SHA=""
LABEL plaintrace.app.ref="${APP_REF}" plaintrace.app.sha="${APP_SHA}"

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

WORKDIR /home/frappe/frappe-bench

# Move assets to image-layer storage
RUN cp -r /home/frappe/frappe-bench/sites/assets /home/frappe/frappe-bench/assets && \
  rm -rf /home/frappe/frappe-bench/sites/assets

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/logs" \
]

USER root
# This entrypoint script link build assets of the image to the mounted sites volume at container initialization
COPY resources/core/main-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

COPY resources/core/start.sh /usr/local/bin/start.sh
RUN chmod 755 /usr/local/bin/start.sh

# nginx (the "frontend" service runs this same image). Frappe's stock nginx config redirects every URL ending
# in "/" to the same URL without it, but KiCad requests the library root as /kicad/v1/ (with the slash) and may
# not follow a redirect. Pass /kicad/ straight through to the backend instead. The build fails if the insert
# does not land, so a change in the base image's template cannot silently reintroduce the redirect.
RUN awk 'BEGIN{b="\tlocation /kicad/ {\n\t\ttry_files /kicad-passthrough @webserver;\n\t}\n"} /^\tlocation @webserver \{/ && !d {print b; d=1} {print}' \
      /templates/nginx/frappe.conf.template > /tmp/frappe.conf.template && \
    grep -q "location /kicad/" /tmp/frappe.conf.template && \
    mv /tmp/frappe.conf.template /templates/nginx/frappe.conf.template

USER frappe
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

CMD ["start.sh"]
